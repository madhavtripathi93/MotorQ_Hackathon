# ==============================================================================
# VISTA (Vehicle Intelligence Signal Trust & Assurance) Environment Configuration
# ==============================================================================

# Core Runtime Environment (development | production | test)
NODE_ENV=development
PORT=3000
UI_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Cryptographic & Security Tokens
# In production, specify a high-entropy 256-bit random secret string
JWT_SECRET=replace_with_secure_random_production_secret_32chars_min
TENANT_SALT=replace_with_secure_random_tenant_salt_entropy

# Relational 3NF Storage (PostgreSQL)
DATABASE_URL=postgres://vista:vista_secret@localhost:5432/vista

# Hot In-Memory & Trust Cache (Redis)
REDIS_URL=redis://localhost:6379

# Event Streaming Backbone (Apache Kafka)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=vista-core-platform
KAFKA_GROUP_ID=vista-veracity-workers

# Columnar Time-Series Analytics (ClickHouse)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default

# Telemetry Simulator & Engine Parameters
SIMULATOR_VEHICLES=1000
STREAMING_BATCH_SIZE=500
BATCH_INTERVAL_MS=1000
